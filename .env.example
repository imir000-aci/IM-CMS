# Application
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://imcms:imcms@localhost:5432/imcms?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-256-bit-random-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-also-256-bit

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=im-cms-assets
CDN_BASE_URL=http://localhost:9000/im-cms-assets

# Delivery API
DELIVERY_PORT=3001
DELIVERY_CACHE_TTL_SECONDS=30

# SAML (optional)
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=

# OAuth (optional)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_DISCOVERY_URL=

# Audiences Platform (Phase 2+)
AUDIENCES_API_URL=
AUDIENCES_API_KEY=
AUDIENCES_SYNC_INTERVAL_SECONDS=900

# Experimentation Platform (Phase 4+)
EXPERIMENTATION_API_URL=
EXPERIMENTATION_API_KEY=
